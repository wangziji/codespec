{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "policies"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "policy_id",
          "capability",
          "operation",
          "resource_pattern",
          "allowed_argv_prefix",
          "required_run_state",
          "approval_digest",
          "actor_class",
          "timeout_seconds",
          "idempotency_strategy",
          "reconciliation_strategy",
          "allowed_environment_names",
          "allowed_write_roots"
        ],
        "properties": {
          "policy_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "capability": {"type": "string", "minLength": 1},
          "operation": {"enum": ["read", "write", "execute"]},
          "resource_pattern": {"type": "string", "minLength": 1},
          "allowed_argv_prefix": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "required_run_state": {
            "enum": [
              "new", "discovery", "requirements", "gate_1", "design", "modules",
              "gate_2", "planning", "gate_3", "implementation", "verification", "test",
              "production_authorization", "prod", "acceptance", "completed", "incident",
              "correction", "rollback", "safe_checkpoint"
            ]
          },
          "approval_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "actor_class": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
          "idempotency_strategy": {"const": "effect-id"},
          "reconciliation_strategy": {"const": "journal-probe"},
          "allowed_environment_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          },
          "allowed_write_roots": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^/"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
